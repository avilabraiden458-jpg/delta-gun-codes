{
  "name": "delta-gun-codes",
  "productName": "改枪码工作台",
  "version": "1.1.0",
  "description": "三角洲行动 · 改枪码工作台：存储、分类、复制改枪码，支持手机同步与多格式导入",
  "main": "main.js",
  "license": "MIT",
  "author": {
    "name": "avilabraiden458-jpg"
  },
  "scripts": {
    "start": "electron .",
    "smoke": "electron . --smoke",
    "dist": "electron-builder"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.deltagun.workbench",
    "productName": "改枪码工作台",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "server-core.js",
      "fileparse.js",
      "app/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "改枪码工作台",
      "artifactName": "delta-gun-codes-setup-${version}-${arch}.${ext}"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "category": "public.app-category.utilities",
      "identity": null,
      "artifactName": "delta-gun-codes-${version}-${arch}.${ext}"
    },
    "publish": {
      "provider": "github",
      "owner": "avilabraiden458-jpg",
      "repo": "delta-gun-codes"
    }
  }
}